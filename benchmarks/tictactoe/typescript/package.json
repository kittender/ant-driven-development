{
  "name": "tictactoe-typescript",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ADD benchmark: tic-tac-toe as a TypeScript single page application. Built by the colony from its own honey in ./spec, seeded from ../spec.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "dupes": "jscpd src",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "jscpd": "^4.0.5",
    "quickpickle": "^1.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
